@model IEnumerable<TaskManager.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<h1>Projects</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@(item.Description?.Substring(0, Math.Min(100, item.Description?.Length ?? 0)))</p>
                    <p>Created: @item.CreatedAt.ToShortDateString()</p>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">View Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-secondary">Edit</a>
                </div>
            </div>
        </div>
    }
</div>