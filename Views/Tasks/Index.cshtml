@model IEnumerable<TaskManager.Models.TaskItem>

@{
    ViewData["Title"] = "My Tasks";
}

<h1>My Tasks</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<div id="react-task-list" data-tasks="@Json.Serialize(Model)"></div>

@section Scripts {
    <script src="~/js/taskList.bundle.js"></script>
}