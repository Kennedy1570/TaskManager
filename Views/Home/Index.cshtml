@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Task Manager</h1>
    <p>A simple application to manage your projects and tasks.</p>
</div>

@if (User.Identity.IsAuthenticated)
{
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>My Upcoming Tasks</h5>
                </div>
                <div class="card-body">
                    @if (ViewData["UpcomingTasks"] != null && ((IEnumerable<TaskManager.Models.TaskItem>)ViewData["UpcomingTasks"]).Any())
                    {
                        <ul class="list-group">
                            @foreach (var task in (IEnumerable<TaskManager.Models.TaskItem>)ViewData["UpcomingTasks"])
                            {
                                <li class="list-group-item">
                                    <span>@task.Title</span>
                                    <span class="float-end">@task.DueDate.ToShortDateString()</span>
                                </li>
                            }
                        </ul>
                        <div class="mt-3">
                            <a asp-controller="Tasks" asp-action="Index" class="btn btn-primary btn-sm">View All Tasks</a>
                        </div>
                    }
                    else
                    {
                        <p>No upcoming tasks.</p>
                        <a asp-controller="Tasks" asp-action="Create" class="btn btn-primary btn-sm">Create a Task</a>
                    }
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5>My Projects</h5>
                </div>
                <div class="card-body">
                    <a asp-controller="Projects" asp-action="Index" class="btn btn-primary btn-sm">View Projects</a>
                    <a asp-controller="Projects" asp-action="Create" class="btn btn-secondary btn-sm">Create New Project</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <h5>Get Started</h5>
                    <p>Please log in or register to start managing your tasks.</p>
                </div>
            </div>
        </div>
    </div>
